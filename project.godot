; BusSimulator - Godot 4 project configuration
; Engine: Godot 4.4 (Forward+ / PBR)
; Target: Android (landscape 1280x720), physics at 60 FPS

config_version=5

[application]

config/name="BusSimulator"
config/description="A 3D bus simulator mobile game (Ultimate Bus Simulator / Euro Truck Simulator 2 inspired)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
environment/glow/use_bicubic_upscale=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/handheld/orientation="landscape"

[physics]

common/physics_ticks_per_second=60

[input]

horn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"",keycode=72)]
}
door={
"deadzone": 0.5,
"events": [Object(InputEventKey,"",keycode=69)]
}
camera_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"",keycode=67)]
}
brake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"",keycode=32)]
}

[android]

; Android export settings (filled further by export_presets.cfg)
; Default orientation handled by display/window/handheld/orientation above.
